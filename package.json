{
  "name": "dsh-feishu",
  "version": "0.3.0",
  "description": "Feishu/Lark tools for DeepSeek Harness: messages, docs, Base (多维表格), calendar, sheets, tasks and approvals — backed by your local lark-cli, with a Web settings page.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cli.js",
    "settings.js",
    "routes.js",
    "tools-messaging.js",
    "tools-base.js",
    "tools-calendar.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "tools-sheets.js",
    "tools-tasks.js",
    "tools-approval.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [],
      "immediately": true
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "feishu",
    "lark",
    "lark-cli",
    "bitable",
    "base",
    "calendar",
    "plugin",
    "bundle"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chuxusave/dsh-feishu.git"
  }
}
